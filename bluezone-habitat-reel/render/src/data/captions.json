{
 "vo_offset": 0.4,
 "chunks": [
  {
   "line": 1,
   "text": "ഒരു സ്വപ്നമുണ്ട്…",
   "start": 0.4,
   "end": 1.79
  },
  {
   "line": 2,
   "text": "നമ്മുടെ മലപ്പുറത്തെ Singapore-ഉം",
   "start": 1.98,
   "end": 3.62
  },
  {
   "line": 2,
   "text": "Dubai-യും പോലെ",
   "start": 3.62,
   "end": 5.15
  },
  {
   "line": 2,
   "text": "ലോകോത്തര നിലവാരത്തിലേക്ക് ഉയർത്തുക",
   "start": 5.18,
   "end": 7.14
  },
  {
   "line": 2,
   "text": "എന്ന സ്വപ്നം.",
   "start": 7.14,
   "end": 8.38
  },
  {
   "line": 3,
   "text": "ആ സ്വപ്നമാണ് Mission Malappuram 2050.",
   "start": 8.67,
   "end": 12.31
  },
  {
   "line": 4,
   "text": "IIT Madras Research Park-ൽ",
   "start": 12.59,
   "end": 14.55
  },
  {
   "line": 4,
   "text": "incubated ആയ 3G IRPS-ന്റെ",
   "start": 14.55,
   "end": 16.62
  },
  {
   "line": 4,
   "text": "founder ആയ",
   "start": 16.62,
   "end": 18.17
  },
  {
   "line": 4,
   "text": "Dr. Sahid Cholayil-ന്റെ",
   "start": 18.17,
   "end": 19.82
  },
  {
   "line": 4,
   "text": "research-driven vision-ൽ നിന്ന് രൂപംകൊണ്ട,",
   "start": 19.82,
   "end": 22.42
  },
  {
   "line": 4,
   "text": "longevity science-നെ",
   "start": 22.44,
   "end": 23.78
  },
  {
   "line": 4,
   "text": "അടിസ്ഥാനമാക്കിയുള്ള ഒരു",
   "start": 23.78,
   "end": 25.03
  },
  {
   "line": 4,
   "text": "വലിയ മുന്നേറ്റം.",
   "start": 25.03,
   "end": 26.53
  },
  {
   "line": 5,
   "text": "മലപ്പുറത്തെ visionary millionaires",
   "start": 26.71,
   "end": 28.72
  },
  {
   "line": 5,
   "text": "ചേർന്ന് മുന്നോട്ട് നയിക്കുന്ന ഒരു premium community.",
   "start": 28.72,
   "end": 32.0
  },
  {
   "line": 6,
   "text": "ആ vision-ന്റെ ഭാഗമായി ഒരുങ്ങുന്ന",
   "start": 32.24,
   "end": 34.23
  },
  {
   "line": 6,
   "text": "പുതിയൊരു ജീവിതസങ്കൽപ്പം.",
   "start": 34.23,
   "end": 36.05
  },
  {
   "line": 7,
   "text": "Blue Zone Habitat.",
   "start": 36.18,
   "end": 37.86
  },
  {
   "line": 8,
   "text": "മലപ്പുറത്തിന്റെ ഹൃദയമായ ആനക്കയത്ത്",
   "start": 38.03,
   "end": 40.0
  },
  {
   "line": 8,
   "text": "ഒരുങ്ങുന്ന ലോകോത്തര നിലവാരമുള്ള",
   "start": 40.0,
   "end": 42.56
  },
  {
   "line": 8,
   "text": "ടൗൺഷിപ്പിന്റെ ഭാഗമായ residential project-ൽ",
   "start": 42.56,
   "end": 45.55
  },
  {
   "line": 8,
   "text": "51 premium signature villas.",
   "start": 45.58,
   "end": 48.33
  },
  {
   "line": 9,
   "text": "3, 4, 5 BHK ഓപ്ഷനുകൾ.",
   "start": 48.43,
   "end": 51.2
  },
  {
   "line": 10,
   "text": "Gen Z-യുടെയും Gen Alpha-യുടെയും",
   "start": 51.36,
   "end": 53.76
  },
  {
   "line": 10,
   "text": "ഭാവി ജീവിതരീതികൾക്കായി രൂപകല്പന",
   "start": 53.76,
   "end": 55.37
  },
  {
   "line": 10,
   "text": "ചെയ്ത ഒരു community.",
   "start": 55.37,
   "end": 57.61
  },
  {
   "line": 11,
   "text": "Work from home-നായി dedicated office space.",
   "start": 57.73,
   "end": 60.7
  },
  {
   "line": 12,
   "text": "മനുഷ്യനെയും പ്രകൃതിയെയും",
   "start": 60.82,
   "end": 61.63
  },
  {
   "line": 12,
   "text": "മുൻനിർത്തിയ materials-ഉം design philosophy-യും.",
   "start": 61.63,
   "end": 65.43
  },
  {
   "line": 13,
   "text": "ഏകദേശം 43% open space-നും",
   "start": 65.58,
   "end": 67.87
  },
  {
   "line": 13,
   "text": "greenery-ക്കുമായി പ്ലാൻ",
   "start": 67.87,
   "end": 69.84
  },
  {
   "line": 13,
   "text": "ചെയ്തിരിക്കുന്നു.",
   "start": 69.84,
   "end": 71.01
  },
  {
   "line": 14,
   "text": "ശാന്തതയ്ക്ക് Garden Ethen.",
   "start": 71.13,
   "end": 73.17
  },
  {
   "line": 15,
   "text": "കുട്ടികളുടെ സന്തോഷത്തിന്",
   "start": 73.29,
   "end": 74.73
  },
  {
   "line": 15,
   "text": "Garden Elara.",
   "start": 74.73,
   "end": 76.01
  },
  {
   "line": 16,
   "text": "Fitness-നും family gatherings-നും",
   "start": 76.21,
   "end": 78.28
  },
  {
   "line": 16,
   "text": "ഒരു premium clubhouse.",
   "start": 78.28,
   "end": 80.01
  },
  {
   "line": 17,
   "text": "Science, technology, nature എന്നിവ",
   "start": 80.09,
   "end": 82.44
  },
  {
   "line": 17,
   "text": "ഒരുമിക്കുന്ന ഒരു പുതിയ lifestyle.",
   "start": 82.44,
   "end": 85.15
  },
  {
   "line": 18,
   "text": "ഇത് വെറുമൊരു villa അല്ല…",
   "start": 85.26,
   "end": 87.07
  },
  {
   "line": 19,
   "text": "ഭാവിയിലേക്ക് ചിന്തിച്ചൊരു",
   "start": 87.23,
   "end": 88.71
  },
  {
   "line": 19,
   "text": "ജീവിതരീതിയാണ്.",
   "start": 88.71,
   "end": 90.12
  },
  {
   "line": 20,
   "text": "Blue Zone Habitat.",
   "start": 90.26,
   "end": 91.91
  },
  {
   "line": 21,
   "text": "Where Peace Meets Luxury.",
   "start": 92.04,
   "end": 94.07
  },
  {
   "line": 22,
   "text": "Project walkthrough ബുക്ക് ചെയ്യാൻ",
   "start": 94.3,
   "end": 95.89
  },
  {
   "line": 22,
   "text": "ഇന്നുതന്നെ ബന്ധപ്പെടൂ.",
   "start": 95.89,
   "end": 97.49
  }
 ],
