{
 "vo_offset": 0.4,
 "chunks": [
  {
   "line": 1,
   "text": "ഒരു സ്വപ്നമുണ്ട്…",
   "start": 0.45,
   "end": 1.7
  },
  {
   "line": 2,
   "text": "നമ്മുടെ മലപ്പുറത്തെ Singapore-ഉം",
   "start": 2.01,
   "end": 4.65
  },
  {
   "line": 2,
   "text": "Dubai-യും പോലെ ലോകോത്തര",
   "start": 4.65,
   "end": 5.86
  },
  {
   "line": 2,
   "text": "നിലവാരത്തിലേക്ക് ഉയർത്തുക എന്ന സ്വപ്നം.",
   "start": 5.86,
   "end": 8.54
  },
  {
   "line": 3,
   "text": "ആ സ്വപ്നമാണ് Mission Malappuram 2050.",
   "start": 8.9,
   "end": 12.61
  },
  {
   "line": 4,
   "text": "IIT Madras Research Park-ൽ",
   "start": 12.94,
   "end": 14.96
  },
  {
   "line": 4,
   "text": "incubated ആയ 3G IRPS-ന്റെ",
   "start": 14.96,
   "end": 17.73
  },
  {
   "line": 4,
   "text": "research-driven vision-ൽ നിന്ന്",
   "start": 17.73,
   "end": 20.21
  },
  {
   "line": 4,
   "text": "രൂപംകൊണ്ട ഒരു വലിയ മുന്നേറ്റം.",
   "start": 20.21,
   "end": 21.87
  },
  {
   "line": 5,
   "text": "മലപ്പുറത്തെ visionary millionaires",
   "start": 22.17,
   "end": 24.89
  },
  {
   "line": 5,
   "text": "ചേർന്ന് മുന്നോട്ട് നയിക്കുന്ന ഒരു premium community.",
   "start": 24.89,
   "end": 27.84
  },
  {
   "line": 6,
   "text": "ആ vision-ന്റെ ഭാഗമായി ഒരുങ്ങുന്ന",
   "start": 28.06,
   "end": 30.08
  },
  {
   "line": 6,
   "text": "പുതിയൊരു ജീവിതസങ്കൽപ്പം.",
   "start": 30.08,
   "end": 31.94
  },
  {
   "line": 7,
   "text": "Blue Zone Habitat.",
   "start": 32.11,
   "end": 33.74
  },
  {
   "line": 8,
   "text": "മലപ്പുറത്തിന്റെ ഹൃദയമായ ആനക്കയത്ത്",
   "start": 33.87,
   "end": 35.96
  },
  {
   "line": 8,
   "text": "ഒരുങ്ങുന്ന 51 premium",
   "start": 35.96,
   "end": 37.86
  },
  {
   "line": 8,
   "text": "signature villas.",
   "start": 37.86,
   "end": 39.78
  },
  {
   "line": 9,
   "text": "3, 4, 5 BHK ഓപ്ഷനുകൾ.",
   "start": 39.92,
   "end": 42.95
  },
  {
   "line": 10,
   "text": "Gen Z-യുടെയും Gen Alpha-യുടെയും",
   "start": 43.08,
   "end": 45.55
  },
  {
   "line": 10,
   "text": "ഭാവി ജീവിതരീതികൾക്കായി രൂപകല്പന",
   "start": 45.55,
   "end": 47.21
  },
  {
   "line": 10,
   "text": "ചെയ്ത ഒരു community.",
   "start": 47.21,
   "end": 49.45
  },
  {
   "line": 11,
   "text": "Work from home-നായി dedicated office space.",
   "start": 49.58,
   "end": 52.63
  },
  {
   "line": 12,
   "text": "മനുഷ്യനെയും പ്രകൃതിയെയും",
   "start": 52.69,
   "end": 53.54
  },
  {
   "line": 12,
   "text": "മുൻനിർത്തിയ materials-ഉം design philosophy-യും.",
   "start": 53.54,
   "end": 57.34
  },
  {
   "line": 13,
   "text": "ഏകദേശം 43% open space-നും",
   "start": 57.5,
   "end": 59.84
  },
  {
   "line": 13,
   "text": "greenery-ക്കുമായി പ്ലാൻ",
   "start": 59.84,
   "end": 61.85
  },
  {
   "line": 13,
   "text": "ചെയ്തിരിക്കുന്നു.",
   "start": 61.85,
   "end": 62.99
  },
  {
   "line": 14,
   "text": "ശാന്തതയ്ക്ക് Garden Ethen.",
   "start": 63.1,
   "end": 65.32
  },
  {
   "line": 15,
   "text": "കുട്ടികളുടെ സന്തോഷത്തിന്",
   "start": 65.45,
   "end": 66.96
  },
  {
   "line": 15,
   "text": "Garden Elara.",
   "start": 66.96,
   "end": 68.31
  },
  {
   "line": 16,
   "text": "Fitness-നും family gatherings-നും",
   "start": 68.46,
   "end": 70.95
  },
  {
   "line": 16,
   "text": "ഒരു premium clubhouse.",
   "start": 70.95,
   "end": 72.47
  },
  {
   "line": 17,
   "text": "Science, technology, nature എന്നിവ",
   "start": 72.57,
   "end": 75.02
  },
  {
   "line": 17,
   "text": "ഒരുമിക്കുന്ന ഒരു പുതിയ lifestyle.",
   "start": 75.02,
   "end": 77.79
  },
  {
   "line": 18,
   "text": "ഇത് വെറുമൊരു villa അല്ല…",
   "start": 78.0,
   "end": 79.86
  },
  {
   "line": 19,
   "text": "ഭാവിയിലേക്ക് ചിന്തിച്ചൊരു",
   "start": 80.12,
   "end": 81.62
  },
  {
   "line": 19,
   "text": "ജീവിതരീതിയാണ്.",
   "start": 81.62,
   "end": 83.01
  },
  {
   "line": 20,
   "text": "Blue Zone Habitat.",
   "start": 83.19,
   "end": 84.78
  },
  {
   "line": 21,
   "text": "Where Peace Meets Luxury.",
   "start": 84.87,
   "end": 86.96
  },
  {
   "line": 22,
   "text": "Project walkthrough ബുക്ക് ചെയ്യാൻ",
   "start": 87.12,
   "end": 88.82
  },
  {
   "line": 22,
   "text": "ഇന്നുതന്നെ ബന്ധപ്പെടൂ.",
   "start": 88.82,
   "end": 90.46
  }
 ],
